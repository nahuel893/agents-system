# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# RAG retrieval
RAG_THRESHOLD_DIRECT=0.92
RAG_THRESHOLD_AMBIGUOUS=0.82
RAG_TOP_K=3
RAG_KEYWORD_TOP_K=5
RAG_HNSW_EF_SEARCH=40

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agents_system
# Redis
REDIS_URL=redis://localhost:6379/0

# WhatsApp / Meta
META_WEBHOOK_SECRET=your-webhook-verify-token
META_PHONE_NUMBER_ID=123456789
META_ACCESS_TOKEN=EAAx...
WHATSAPP_TOKEN=EAAx...
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=123456789

# Runtime Registrations (ADR-004) -- deployer-chosen runtime id -> a
# predefined role, optionally scoped to a client ("{role}" or
# "{role}@{client}"). Every id used below (DEPLOY_GRANTS, ADAPTER_RUNTIMES,
# WHATSAPP_RUNTIME_ID) must be a key here, or boot fails naming it.
AGENT_REGISTRATIONS={"acme-sales": "sales-agent@acme"}

# Deploy-time permission grants (issue #38) -- REQUIRED for every runtime id
# registered above (AGENT_REGISTRATIONS) that is also configured as a live
# runtime (ADAPTER_RUNTIMES / WHATSAPP_RUNTIME_ID). Boot refuses to start for
# a configured runtime with no matching entry here; there is no automatic
# grant.
DEPLOY_GRANTS={"acme-sales": ["read:catalog", "write:orders"]}

# Slack (optional, for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# App
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Outline wiki (scripts/upload_outline.py, scripts/cleanup_outline_duplicates.py)
#
# These were hardcoded literals in both scripts until 2026-08-28 and sat in a
# PUBLIC repository for three months. Secret scanning never flagged them:
# `secret_scanning_non_provider_patterns` was disabled and Outline is not a
# recognised provider, so no alert was ever raised. The exposed token has been
# rotated. Both scripts now exit if these are unset.
OUTLINE_API_TOKEN=ol_api_...
OUTLINE_BASE_URL=https://your-outline-host
OUTLINE_WORKSPACE_DIR=docs

# Database Connection Pool Sizing (ADR-001)
# Sizing formula:
#   total connections = processes * sum(pool_size + max_overflow for every engine)
#   Must remain strictly below PostgreSQL max_connections - 3 (reserved).
# In-process operational pool constraint:
#   database_pool_size + database_max_overflow >= max_concurrent_turns + 2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=30
DATABASE_POOL_RECYCLE_S=1800

# Dedicated BI connection (read-only role, ADR-001 / D-023)
BI_DATABASE_URL=
BI_POOL_SIZE=3
BI_MAX_OVERFLOW=0
BI_POOL_TIMEOUT_S=30
BI_POOL_RECYCLE_S=1800

# Dedicated SQL tool connection (read-only, zero overflow)
SQL_POOL_SIZE=2
SQL_MAX_OVERFLOW=0
SQL_POOL_TIMEOUT_S=30
SQL_POOL_RECYCLE_S=1800

# Concurrency & Admission Control (ADR-001 Stage A default: 10 concurrent turns)
MAX_CONCURRENT_TURNS=10
ADMISSION_WAIT_TIMEOUT_S=10.0

# WhatsApp Runtime Wiring & Deferred Webhook Worker (W2b2 / ADR-001)
# WHATSAPP_RUNTIME_ID=sales
WHATSAPP_CHECKPOINTER_ENABLED=true
# Conversation threads are kept in Postgres (DATABASE_URL); `alembic upgrade
# head` creates their tables. How long an IDLE conversation is kept is a
# business decision (personal data): see docs/platform/conversation-memory.md.
# `never` keeps conversations indefinitely.
CHECKPOINTER_RETENTION_S=86400
CHECKPOINTER_PURGE_INTERVAL_S=3600
CHECKPOINTER_POOL_SIZE=5
CHECKPOINTER_TIMEOUT_S=5.0
WEBHOOK_WORKER_POLL_INTERVAL_S=1.0
WEBHOOK_WORKER_CLAIM_LIMIT=10

# Runtime Registrations & Adapter (ADR-004)
# AGENT_REGISTRATIONS={"sales": "sales-agent"}
# ADAPTER_RUNTIMES=["sales"]
# ADAPTER_API_KEY=your-adapter-api-key

# Optional custom registry factory (format: module.submodule:callable)
REGISTRY_FACTORY=

# Prometheus Metrics (ADR-005 / issue #78)
METRICS_ENABLED=false
METRICS_API_KEY=
