# agents-system environment configuration template (issue #12 / D-036)
# Place in /etc/agents-system/agents-system.env (chmod 600, owned by agents-system)

# Environment & Security
ENVIRONMENT=production
DEBUG=false
ALLOW_INSECURE=false
LOG_LEVEL=INFO

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://agents_system:your-db-password@127.0.0.1:5432/agents_system
# Or component variables:
# DB_USER=agents_system
# DB_PASSWORD=your-db-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=agents_system

# Database Connection Pool Sizing (ADR-001)
# Formula: total connections = processes * sum(pool_size + max_overflow for every engine)
# Must remain below PostgreSQL max_connections - 3 (reserved).
# In-process operational pool constraint:
#   database_pool_size + database_max_overflow >= max_concurrent_turns + 2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_S=30
DATABASE_POOL_RECYCLE_S=1800

# Dedicated BI connection (read-only role, ADR-001 / D-023)
BI_DATABASE_URL=
BI_POOL_SIZE=3
BI_MAX_OVERFLOW=0
BI_POOL_TIMEOUT_S=30
BI_POOL_RECYCLE_S=1800

# Dedicated SQL tool connection (read-only, zero overflow)
SQL_POOL_SIZE=2
SQL_MAX_OVERFLOW=0
SQL_POOL_TIMEOUT_S=30
SQL_POOL_RECYCLE_S=1800

# Concurrency & Admission Control (ADR-001 Stage A default: 10 concurrent turns)
MAX_CONCURRENT_TURNS=10
ADMISSION_WAIT_TIMEOUT_S=10.0

# Redis (reported by GET /health; conversation state is in Postgres since #24)
REDIS_URL=redis://127.0.0.1:6379/0

# LLM Providers (set credentials for active providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ADAPTER_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# RAG & Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3
RAG_THRESHOLD_DIRECT=0.60
RAG_THRESHOLD_AMBIGUOUS=0.50
RAG_TOP_K=3
RAG_KEYWORD_TOP_K=5
RAG_HNSW_EF_SEARCH=40

# WhatsApp / Meta Cloud API
META_WEBHOOK_SECRET=your-meta-webhook-verify-token
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
WHATSAPP_TOKEN=
# Required (non-empty) whenever WHATSAPP_RUNTIME_ID is set: the boot fails otherwise.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Runtime Wiring & Deferred Webhook Worker (W2b2 / ADR-001)
WHATSAPP_RUNTIME_ID=sales
WHATSAPP_CHECKPOINTER_ENABLED=true
# Conversation threads are kept in Postgres (DATABASE_URL); `alembic upgrade
# head` creates their tables. How long an IDLE conversation is kept is a
# business decision (personal data): see docs/platform/conversation-memory.md.
# `never` keeps conversations indefinitely.
CHECKPOINTER_RETENTION_S=86400
CHECKPOINTER_PURGE_INTERVAL_S=3600
CHECKPOINTER_POOL_SIZE=5
CHECKPOINTER_TIMEOUT_S=5.0
WEBHOOK_WORKER_POLL_INTERVAL_S=1.0
WEBHOOK_WORKER_CLAIM_LIMIT=10

# Runtime Registrations & OpenAI-compatible Adapter (ADR-004)
AGENT_REGISTRATIONS={"sales": "sales-agent"}
ADAPTER_RUNTIMES=["sales"]
ADAPTER_API_KEY=your-adapter-api-key

# Deploy-time permission grants (issue #38) -- REQUIRED for every registered runtime id.
# Boot refuses to start for a configured runtime with no matching entry here.
DEPLOY_GRANTS={"sales": ["read:catalog", "write:orders"]}

# Optional custom registry factory (format: module.submodule:callable)
REGISTRY_FACTORY=

# Prometheus Metrics (ADR-005 / issue #78)
METRICS_ENABLED=false
METRICS_API_KEY=
